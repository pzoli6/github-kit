AGENT_PROJECT_OWNER="pzoli6"
AGENT_PROJECT_NUMBER="TBD"
AGENT_PROJECT_NAME="TBD"
AGENT_DEFAULT_BASE_BRANCH="develop"
AGENT_DEFAULT_ISSUE_ASSIGNEE="@me"
AGENT_DEFAULT_PR_ASSIGNEE="@me"
AGENT_DEFAULT_REVIEWER=""
AGENT_DEFAULT_ISSUE_LABELS="status:ready-for-agent,type:agent-task"
AGENT_DEFAULT_PR_LABELS="type:agent-task"
AGENT_DEFAULT_MILESTONE=""
AGENT_DEFAULT_AGENT_NAME="TBD"
AGENT_DEFAULT_AREA="TBD"
AGENT_DEFAULT_RISK="TBD"
AGENT_DEFAULT_ENVIRONMENT="TBD"
# Minutes before another agent's claim on an issue (Status + Last Agent Update) is considered
# stale by scripts/project/check_resume_safety.sh. Default 120 if unset.
AGENT_CLAIM_STALENESS_MINUTES="120"

# --- Worktree + dev-environment facts -------------------------------------------------------
# scripts/project/publish_agent_branch.sh creates each agent task in its own git worktree and
# writes a WORKTREE.md preamble into it from the values below, so an agent picking up the task
# doesn't burn calls rediscovering them. All optional — a blank or "TBD" value is simply omitted
# from WORKTREE.md. None of these are secrets.
#
# Where worktrees are created. Default: <repo-parent>/<repo-name>-worktrees/<slug>. Override the
# parent dir here if you keep worktrees elsewhere.
AGENT_WORKTREE_BASE=""
# The dev-server command (e.g. "npm run dev"). Surfaced in WORKTREE.md.
AGENT_DEV_SERVER_CMD=""
# Base port for per-worktree dev servers. publish_agent_branch.sh derives a deterministic unique
# port per worktree (base + a hash of the slug, 0-99) so parallel agents don't collide on one port.
# Leave blank if this repo has no dev server.
AGENT_DEV_PORT_BASE=""
# How to do visual/manual QA without hitting an auth wall (e.g. "use the /dev preview route").
AGENT_PREVIEW_ROUTE=""
# Anything an agent must know about auth-gating before it tries to load the app.
AGENT_AUTH_NOTE=""
# The few paths a newcomer needs first (e.g. "src/app, src/components, src/lib/db.ts").
AGENT_KEY_PATHS=""
# Browser/visual-QA gotchas (e.g. "Playwright: launch chromium with channel:'chrome'").
AGENT_VISUAL_QA_NOTE=""
# Optional path (relative to repo root) to a launch.json template copied into the worktree's
# .claude/ with __AGENT_DEV_PORT__ substituted for the unique port. Leave blank to skip.
AGENT_LAUNCH_TEMPLATE=""
